# Local development only. Never put real credentials in this file or commit .env.
SERPAPI_API_KEY=
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
MONITOR_OWNER_PASSWORD=replace-with-a-password-at-least-12-characters
FLIGHT_DATABASE_PATH=data/flights.db
FARE_MONITOR_ENABLED=false
MAX_WEB_SERPAPI_BUDGET=50
MONITOR_MAX_SERPAPI_BUDGET=50
MONITOR_MAX_DAILY_SERPAPI_BUDGET=50
FARE_CHANGE_MIN_ABS_INR=1000
FARE_CHANGE_MIN_PERCENT=3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COOKIE_SECURE=false
DATABASE_URL=
# Optional: when DATABASE_URL is blank, this SQLite file is used.
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
